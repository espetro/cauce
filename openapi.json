            "type": "boolean"
          },
          "base_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Url"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model"
        ],
        "title": "SettingsPayload",
        "type": "object"
      },
      "SettingsWritePayload": {
        "additionalProperties": false,
        "description": "PUT body: same fields, but blank forms are invalid here.\n\n``provider`` is narrowed to the same set as ``oxe.config``'s\n``VALID_PROVIDERS`` (which the ``_ProviderLiteral`` literal mirrors) and\n``model`` must be non-empty: a value the next ``load_config`` would reject\n(500 on every later GET) must never be persisted. Response payloads keep\nthe unconstrained ``SettingsPayload`` so the unconfigured blank form stays\nschema-valid. Narrowing (not redeclaring) the inherited fields keeps the\nsingle source of truth for the field list.",
        "properties": {
          "api_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          },
          "api_key_env": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key Env"
          },
          "api_key_set": {
            "default": false,
            "title": "Api Key Set",
            "type": "boolean"
          },
          "base_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Url"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "model": {
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "enum": [
              "anthropic",
              "groq",
              "huggingface",
              "mistral",
              "ollama",
              "openai"
            ],
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model"
        ],
        "title": "SettingsWritePayload",
        "type": "object"
      },
      "SourcesFrame": {
        "additionalProperties": false,
