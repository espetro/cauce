          },
          "event": {
            "const": "message",
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "AnswerRequest": {
        "additionalProperties": false,
        "description": "Body of ``POST /answer``.",
        "properties": {
          "force": {
            "anyOf": [
              {
                "enum": [
                  "ai-off",
                  "error",
                  "empty"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Force"
          },
          "mode": {
            "const": "answer",
            "default": "answer",
            "title": "Mode",
            "type": "string"
          },
          "query": {
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "AnswerRequest",
        "type": "object"
      },
      "AnswerSource": {
        "additionalProperties": false,
        "properties": {
          "favicon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Favicon"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "title": "AnswerSource",
        "type": "object"
      },
