    "/api/history": {
      "get": {
        "description": "JSON API for the SPA /history page: merged user activity view.\n\nParams: since=24h|7d|30d|all (default all), q=substring filter,\nlimit=1..200 (default 50), kind=all|clicks|cache (default all).\nReturns {items, clicks, cache_rows, limit, since} sorted newest\nfirst; each item has a `kind` field (\"click\" | \"cache\").",
        "operationId": "api_history_api_history_get",
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "default": "all",
              "enum": [
                "24h",
                "7d",
                "30d",
                "all"
              ],
              "title": "Since",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
