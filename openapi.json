      "UnresponsiveEngine": {
        "additionalProperties": false,
        "description": "One engine that failed to answer, per SearXNG's ``unresponsive_engines``.\n\nSearXNG itself represents this as a two-element list; modelled here as\na named pair so both entry points and tests reference ``.engine`` /\n``.error`` rather than positional indices.",
        "properties": {
          "engine": {
            "title": "Engine",
            "type": "string"
          },
          "error": {
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "engine",
          "error"
        ],
        "title": "UnresponsiveEngine",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ZeroResultQuery": {
        "additionalProperties": false,
        "properties": {
          "last_seen": {
            "title": "Last Seen",
            "type": "integer"
          },
          "query": {
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query",
          "last_seen"
        ],
        "title": "ZeroResultQuery",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "oxe",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/answer": {
      "post": {
        "operationId": "answer_answer_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerFrameEvent"
                }
              }
            },
            "description": "SSE stream of AnswerFrame events."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "AI answer (SSE stream of typed frames)."
      }
    },
    "/api/history": {
      "get": {
        "description": "Click rows newest-first plus the header stats line.\n\n``Query``'s ``ge``/``le`` bounds are a range, not a set, so in-range gap\nvalues (e.g. 48) reach the handler; ``_narrow_since`` turns them into a\n``ValueError``, which FastAPI reports as 500 today. Only the three\nliteral values (24/168/720) are schema-valid for clients, per the\ngenerated OpenAPI ``enum`` -- gap values are caller bugs, not user input.",
        "operationId": "api_history_api_history_get",
        "parameters": [
          {
            "description": "Hours back: 24=day, 168=week, 720=month; absent = all time.",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(24|168|720)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Hours back: 24=day, 168=week, 720=month; absent = all time.",
              "title": "Since"
            }
          },
          {
            "description": "Query-text substring filter.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Query-text substring filter.",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Click history feed."
      }
    },
    "/api/stats": {
      "get": {
        "description": "Aggregates over the search log (searches/day, hit rate, latency\npercentiles, top and zero-result queries, client split).",
        "operationId": "api_stats_api_stats_get",
        "parameters": [
          {
            "description": "Aggregation window in days.",
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 14,
              "description": "Aggregation window in days.",
              "maximum": 90,
              "minimum": 1,
              "title": "Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Dashboard aggregates."
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/search": {
      "get": {
        "operationId": "search_get_search_get",
        "parameters": [
          {
            "description": "Query text.",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Query text.",
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "description": "1-based result page.",
            "in": "query",
            "name": "pageno",
            "required": false,
            "schema": {
              "default": 1,
              "description": "1-based result page.",
              "minimum": 1,
              "title": "Pageno",
              "type": "integer"
            }
          },
          {
            "description": "SearXNG category names.",
            "in": "query",
            "name": "categories",
            "required": false,
            "schema": {
              "default": [
                "general"
              ],
              "description": "SearXNG category names.",
              "items": {
                "type": "string"
              },
              "title": "Categories",
              "type": "array"
            }
          },
          {
            "description": "Language code, or 'all'.",
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "default": "all",
              "description": "Language code, or 'all'.",
              "title": "Language",
              "type": "string"
            }
          },
          {
            "description": "Restrict to results published within this window.",
            "in": "query",
            "name": "time_range",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "year"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Restrict to results published within this window.",
              "title": "Time Range"
            }
          },
          {
            "description": "0=off, 1=moderate, 2=strict.",
            "in": "query",
            "name": "safesearch",
            "required": false,
            "schema": {
              "default": 0,
              "description": "0=off, 1=moderate, 2=strict.",
              "maximum": 2,
              "minimum": 0,
              "title": "Safesearch",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearxResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Get"
      },
      "post": {
        "operationId": "search_post_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearxResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Post"
      }
    },
    "/settings": {
      "get": {
        "description": "The persisted ``[ai]`` config; ``api_key`` is never echoed.",
        "operationId": "get_settings_settings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsPayload"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Current AI config."
      },
      "put": {
        "description": "Full-replace semantics: the body must carry every field (422 otherwise).",
        "operationId": "put_settings_settings_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsWritePayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsPayload"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Persist the AI config."
      }
    }
  }
}
