            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "title",
          "engine"
        ],
        "title": "SearchResult",
        "type": "object"
      },
      "SearchesPerDay": {
        "additionalProperties": false,
        "properties": {
          "cache": {
            "title": "Cache",
