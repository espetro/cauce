            "default": null,
            "title": "Error"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "related_questions": {
            "items": {
              "type": "string"
            },
            "title": "Related Questions",
            "type": "array"
          },
          "type": {
            "const": "done",
            "default": "done",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "answer",
          "confidence",
          "model",
          "cached"
        ],
        "title": "DoneFrame",
        "type": "object"
      },
      "ErrorFrame": {
        "additionalProperties": false,
