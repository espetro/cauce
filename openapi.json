      "SearchRequest": {
        "additionalProperties": false,
        "description": "The canonical SearXNG-shaped search request.\n\nCache identity (``oxe.search.service.cache_key``) is computed on this\nmodel's fields, so the native ``/search`` route and the future Exa\ncompat adapter -- which will build a ``SearchRequest`` from an\nExa-shaped request before calling the service -- share one cache row\nfor the same underlying query.",
        "properties": {
          "categories": {
            "items": {
              "type": "string"
            },
            "title": "Categories",
            "type": "array"
          },
          "language": {
            "default": "all",
            "title": "Language",
            "type": "string"
          },
          "pageno": {
            "default": 1,
            "title": "Pageno",
            "type": "integer"
          },
          "q": {
            "title": "Q",
            "type": "string"
          },
          "safesearch": {
            "default": 0,
            "enum": [
              0,
              1,
              2
            ],
            "title": "Safesearch",
            "type": "integer"
          },
          "time_range": {
            "anyOf": [
              {
                "enum": [
                  "day",
                  "week",
                  "month",
                  "year"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Range"
          }
        },
        "required": [
          "q"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResult": {
        "additionalProperties": false,
        "description": "One canonical SearXNG-shaped search result.",
        "properties": {
          "category": {
            "default": "general",
            "title": "Category",
            "type": "string"
