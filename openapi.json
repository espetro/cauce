      "SearxResponse": {
        "additionalProperties": false,
        "description": "The canonical SearXNG-shaped search response.\n\nTwo of these three rules from the plan's \"search contract\" section are\nenforced here as shape; the third (unresponsive_engines-with-no-results\nmust raise, never be returned) is a service-level invariant, enforced in\n``oxe/search/service.py`` rather than at the model layer, since a\nfreshly-constructed response legitimately passes through this state\nwhile an engine is still composing partial results.",
        "properties": {
          "answers": {
            "items": {
              "type": "string"
            },
            "title": "Answers",
            "type": "array"
          },
          "corrections": {
            "items": {
              "type": "string"
            },
            "title": "Corrections",
            "type": "array"
          },
          "infoboxes": {
            "items": {
              "$ref": "#/components/schemas/Infobox"
            },
            "title": "Infoboxes",
            "type": "array"
          },
          "number_of_results": {
            "default": 0,
            "title": "Number Of Results",
            "type": "integer"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "title": "Results",
            "type": "array"
          },
          "suggestions": {
            "items": {
              "type": "string"
            },
            "title": "Suggestions",
            "type": "array"
          },
          "unresponsive_engines": {
            "items": {
              "$ref": "#/components/schemas/UnresponsiveEngine"
            },
            "title": "Unresponsive Engines",
            "type": "array"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearxResponse",
        "type": "object"
      },
      "SettingsPayload": {
        "additionalProperties": false,
        "description": "Wire mirror of ``AIConfig``; never carries a raw secret outbound.",
