{
  "components": {
    "schemas": {
      "AnswerFrame": {
        "discriminator": {
          "mapping": {
            "delta": "#/components/schemas/DeltaFrame",
            "done": "#/components/schemas/DoneFrame",
            "error": "#/components/schemas/ErrorFrame",
            "sources": "#/components/schemas/SourcesFrame",
            "step": "#/components/schemas/StepFrame"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/StepFrame"
          },
          {
            "$ref": "#/components/schemas/DeltaFrame"
          },
          {
            "$ref": "#/components/schemas/SourcesFrame"
          },
          {
            "$ref": "#/components/schemas/DoneFrame"
          },
          {
            "$ref": "#/components/schemas/ErrorFrame"
          }
        ]
      },
      "AnswerSource": {
        "additionalProperties": false,
        "properties": {
          "favicon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Favicon"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "title": "AnswerSource",
        "type": "object"
      },
      "DeltaFrame": {
        "additionalProperties": false,
        "description": "One chunk of streamed answer text.",
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "delta",
            "default": "delta",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "DeltaFrame",
        "type": "object"
      },
      "DoneFrame": {
        "additionalProperties": false,
        "description": "Terminal frame: the final answer, or a mid-stream model/quality failure.",
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "cached": {
            "title": "Cached",
            "type": "boolean"
          },
          "confidence": {
            "title": "Confidence",
            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "related_questions": {
            "items": {
              "type": "string"
            },
            "title": "Related Questions",
            "type": "array"
          },
          "type": {
            "const": "done",
            "default": "done",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "answer",
          "confidence",
          "model",
          "cached"
        ],
        "title": "DoneFrame",
        "type": "object"
      },
      "ErrorFrame": {
        "additionalProperties": false,
        "description": "Terminal frame for a failure before any ``done`` frame could be built.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "const": "error",
            "default": "error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ErrorFrame",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthStatus": {
        "additionalProperties": false,
        "description": "Response body for the liveness check.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "Infobox": {
        "additionalProperties": false,
        "description": "SearXNG infobox entry (Wikipedia-style side panel content).",
        "properties": {
          "content": {
            "default": "",
            "title": "Content",
            "type": "string"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "img_src": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Img Src"
          },
          "infobox": {
            "title": "Infobox",
            "type": "string"
          },
          "urls": {
            "items": {
              "$ref": "#/components/schemas/InfoboxUrl"
            },
            "title": "Urls",
            "type": "array"
          }
        },
        "required": [
          "infobox"
        ],
        "title": "Infobox",
        "type": "object"
      },
      "InfoboxUrl": {
        "additionalProperties": false,
        "description": "One entry in an ``Infobox.urls`` list.",
        "properties": {
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "title": "InfoboxUrl",
        "type": "object"
      },
      "SearchRequest": {
        "additionalProperties": false,
        "description": "The canonical SearXNG-shaped search request.\n\nCache identity (``oxe.search.service.cache_key``) is computed on this\nmodel's fields, so the native ``/search`` route and the future Exa\ncompat adapter -- which will build a ``SearchRequest`` from an\nExa-shaped request before calling the service -- share one cache row\nfor the same underlying query.",
        "properties": {
          "categories": {
            "items": {
              "type": "string"
            },
            "title": "Categories",
            "type": "array"
          },
          "language": {
            "default": "all",
            "title": "Language",
            "type": "string"
          },
          "pageno": {
            "default": 1,
            "title": "Pageno",
            "type": "integer"
          },
          "q": {
            "title": "Q",
            "type": "string"
          },
          "safesearch": {
            "default": 0,
            "enum": [
              0,
              1,
              2
            ],
            "title": "Safesearch",
            "type": "integer"
          },
          "time_range": {
            "anyOf": [
              {
                "enum": [
                  "day",
                  "week",
                  "month",
                  "year"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Range"
          }
        },
        "required": [
          "q"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResult": {
        "additionalProperties": false,
        "description": "One canonical SearXNG-shaped search result.",
        "properties": {
          "category": {
            "default": "general",
            "title": "Category",
            "type": "string"
          },
          "content": {
            "default": "",
            "title": "Content",
            "type": "string"
          },
          "engine": {
            "title": "Engine",
            "type": "string"
          },
          "engines": {
            "items": {
              "type": "string"
            },
            "title": "Engines",
            "type": "array"
          },
          "publishedDate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Publisheddate"
          },
          "score": {
            "default": 0.0,
            "title": "Score",
            "type": "number"
          },
          "thumbnail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnail"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "title",
          "engine"
        ],
        "title": "SearchResult",
        "type": "object"
      },
      "SearxResponse": {
        "additionalProperties": false,
        "description": "The canonical SearXNG-shaped search response.\n\nTwo of these three rules from the plan's \"search contract\" section are\nenforced here as shape; the third (unresponsive_engines-with-no-results\nmust raise, never be returned) is a service-level invariant, enforced in\n``oxe/search/service.py`` rather than at the model layer, since a\nfreshly-constructed response legitimately passes through this state\nwhile an engine is still composing partial results.",
        "properties": {
          "answers": {
            "items": {
              "type": "string"
            },
            "title": "Answers",
            "type": "array"
          },
          "corrections": {
            "items": {
              "type": "string"
            },
            "title": "Corrections",
            "type": "array"
          },
          "infoboxes": {
            "items": {
              "$ref": "#/components/schemas/Infobox"
            },
            "title": "Infoboxes",
            "type": "array"
          },
          "number_of_results": {
            "default": 0,
            "title": "Number Of Results",
            "type": "integer"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "title": "Results",
            "type": "array"
          },
          "suggestions": {
            "items": {
              "type": "string"
            },
            "title": "Suggestions",
            "type": "array"
          },
          "unresponsive_engines": {
            "items": {
              "$ref": "#/components/schemas/UnresponsiveEngine"
            },
            "title": "Unresponsive Engines",
            "type": "array"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearxResponse",
        "type": "object"
      },
      "SourcesFrame": {
        "additionalProperties": false,
        "description": "The set of sources the answer drew on, once known.",
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/AnswerSource"
            },
            "title": "Sources",
            "type": "array"
          },
          "type": {
            "const": "sources",
            "default": "sources",
            "title": "Type",
            "type": "string"
          }
        },
        "title": "SourcesFrame",
        "type": "object"
      },
      "StepFrame": {
        "additionalProperties": false,
        "description": "A tool call the model is making (e.g. a web search) is starting.",
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "type": {
            "const": "step",
            "default": "step",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "tool",
          "query",
          "label"
        ],
        "title": "StepFrame",
        "type": "object"
      },
      "UnresponsiveEngine": {
        "additionalProperties": false,
        "description": "One engine that failed to answer, per SearXNG's ``unresponsive_engines``.\n\nSearXNG itself represents this as a two-element list; modelled here as\na named pair so both entry points and tests reference ``.engine`` /\n``.error`` rather than positional indices.",
        "properties": {
          "engine": {
            "title": "Engine",
            "type": "string"
          },
          "error": {
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "engine",
          "error"
        ],
        "title": "UnresponsiveEngine",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "oxe",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/search": {
      "get": {
        "operationId": "search_get_search_get",
        "parameters": [
          {
            "description": "Query text.",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Query text.",
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "description": "1-based result page.",
            "in": "query",
            "name": "pageno",
            "required": false,
            "schema": {
              "default": 1,
              "description": "1-based result page.",
              "minimum": 1,
              "title": "Pageno",
              "type": "integer"
            }
          },
          {
            "description": "SearXNG category names.",
            "in": "query",
            "name": "categories",
            "required": false,
            "schema": {
              "default": [
                "general"
              ],
              "description": "SearXNG category names.",
              "items": {
                "type": "string"
              },
              "title": "Categories",
              "type": "array"
            }
          },
          {
            "description": "Language code, or 'all'.",
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "default": "all",
              "description": "Language code, or 'all'.",
              "title": "Language",
              "type": "string"
            }
          },
          {
            "description": "Restrict to results published within this window.",
            "in": "query",
            "name": "time_range",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "year"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Restrict to results published within this window.",
              "title": "Time Range"
            }
          },
          {
            "description": "0=off, 1=moderate, 2=strict.",
            "in": "query",
            "name": "safesearch",
            "required": false,
            "schema": {
              "default": 0,
              "description": "0=off, 1=moderate, 2=strict.",
              "maximum": 2,
              "minimum": 0,
              "title": "Safesearch",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearxResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Get"
      },
      "post": {
        "operationId": "search_post_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearxResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Post"
      }
    }
  }
}
