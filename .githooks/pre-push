#!/bin/sh
# pre-push: cheap local check only. The full gate (`mise run validate`)
# runs in CI (.github/workflows/validate.yml) with cached toolchains and
# build artifacts; run it by hand when you want it locally.
# Install with: mise run hooks:install  (sets core.hooksPath=.githooks)

# Every commit not yet on a remote must carry a Signed-off-by trailer (DCO).
missing=$(git log --format='%H' --not --remotes | while read -r c; do
    git log -1 --format='%(trailers:key=Signed-off-by,valueonly)' "$c" | grep -q . || echo "$c"
done)
if [ -n "$missing" ]; then
    echo "pre-push: commits missing Signed-off-by (use git commit -s):" >&2
    echo "$missing" >&2
    exit 1
fi
