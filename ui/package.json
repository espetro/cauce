{
  "name": "oxe-ui",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --mode prerender && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "oxlint --config .oxlintrc.json src scripts && oxfmt --check src scripts",
    "fmt": "oxfmt src scripts",
    "check": "tsc -b && vite build && vite build --mode prerender && node scripts/prerender.mjs && bun scripts/size-budget.ts",
    "gen:types": "openapi-typescript ../openapi.json -o src/lib/generated/types.gen.ts",
    "test": "bun test src"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "valibot": "^1.5.0",
    "virtua": "^0.51.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.132",
    "@preact/preset-vite": "^2.10.6",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "daisyui": "^5.7.38",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0"
  }
}
