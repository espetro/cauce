# Rust
# Cargo.lock stays committed: this is a binary workspace, not a library.
target/
**/*.rs.bk
*.pdb

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.basedpyright_cache/

# UI build output, never tracked
dist/
dist-ssr/
node_modules/

# caches / local state
.playwright-cli/
.DS_Store
*.log

# secrets
.env
.env.*

# plans are intentionally tracked here even though a global gitignore
# silences .agents/plans/ everywhere else
!.agents/plans/

# per-worktree cargo dirs
target-local/
